# Base image with CUDA 12.8 devel headers (required for compiling extensions)
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    # Standardize the venv path and add it to PATH immediately
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# Install System Dependencies
# Combined into a single RUN to minimize layers and use --no-install-recommends to save space
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    ninja-build \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

# Setup Python Environment (PEP 668 Compliance)
# Creating a venv in a system path (/opt) and adding it to PATH is the modern best practice
# for Ubuntu 24.04+ containers to avoid "externally-managed-environment" errors safely.
RUN python3 -m venv $VIRTUAL_ENV && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch Nightly (CUDA 12.8)
# Note: Target RTX 50-series (Blackwell)
RUN pip install --no-cache-dir --pre torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/nightly/cu128

# Set working directory
WORKDIR /workspace

# Clone SAM3
# Using depth 1 keeps the layer small
RUN git clone --depth 1 https://github.com/facebookresearch/sam3.git

WORKDIR /workspace/sam3

# Install SAM3 and dependencies
# Combined installation to a single layer.
# Note: ".[all]" or comma-separated extras depends on setup.py, listing explicit keys is safer.
RUN pip install --no-cache-dir -e ".[notebooks,train,dev]"

# Default command
CMD ["/bin/bash"]
